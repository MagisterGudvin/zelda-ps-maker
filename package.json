{
  "name": "zelda-maker-toolkit",
  "version": "0.5.2",
  "private": true,
  "description": "Zelda Maker Toolkit — action-adventure (A Link to the Past style) plugin for PS Maker (Pixel Stories).",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "ps-maker-plugin build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node tests/integration/run-phaser-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:integration",
    "harness": "npm run build && node examples/harness/serve.mjs",
    "docs:actions": "npm run build && node scripts/gen-actions-doc.mjs",
    "build:probe": "node scripts/build-probe.mjs"
  },
  "dependencies": {
    "@ps-maker/plugin-api": "0.0.3"
  },
  "devDependencies": {
    "@ps-maker/plugin-cli": "0.1.7",
    "@types/node": "22.18.0",
    "phaser": "3.90.0",
    "playwright-core": "1.56.1",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
